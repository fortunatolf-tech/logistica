# ---- Banco de dados ----
POSTGRES_USER=rotaviva
POSTGRES_PASSWORD=trocar-em-producao
POSTGRES_DB=rotaviva
DATABASE_URL=postgresql://rotaviva:trocar-em-producao@localhost:5432/rotaviva

# ---- Cache / filas ----
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://rotaviva:trocar-em-producao@localhost:5672/

# ---- Object storage (fotos de entrega) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rotaviva
MINIO_SECRET_KEY=trocar-em-producao
MINIO_BUCKET=rotaviva-fotos

# ---- Mapas / geocodificação ----
# provedor ativo: nominatim | google | mapbox (abstração MapProvider, ver ADR-0002)
MAP_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=

# ---- geo-normalizer ----
# bounding box padrão de operação (Brasil); sobrescrevível por tenant
OPERATION_BBOX=-73.99,-33.75,-28.84,5.27
# precisão mínima aceitável em metros
PRECISION_MIN_M=100

# ---- route-optimizer ----
# limiar de desvio (minutos) que dispara re-otimização
REOPT_THRESHOLD_MIN=5
# TTL do cache de matrizes de distância (segundos)
MATRIX_CACHE_TTL_S=120

# ---- api-gateway ----
# Produção: apontar para o JWKS do Keycloak e definir issuer/audience.
# Desenvolvimento: basta o segredo HS256 abaixo (nunca usar em produção).
AUTH_DEV_SECRET=dev-secret-inseguro-trocar
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
RATE_LIMIT_CAPACIDADE=60
RATE_LIMIT_REFILL_S=1
